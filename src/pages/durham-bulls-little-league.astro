---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Durham Bulls Little League - Virginia Beach, VA">
  <Navigation />

  <main class="min-h-screen bg-black">
    <!-- Hero Section -->
    <div class="relative overflow-hidden">
      <!-- Background with baseball diamond pattern -->
      <div class="absolute inset-0 bg-gradient-to-br from-blue-950 via-black to-blue-950 opacity-90"></div>
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 50% 120%, rgba(34, 197, 94, 0.15) 0%, transparent 60%);"></div>

      <!-- Floating baseball stitches decoration -->
      <div class="absolute top-10 right-10 w-32 h-32 rounded-full border-2 border-red-500/20 animate-spin-slow hidden lg:block"></div>
      <div class="absolute bottom-20 left-10 w-20 h-20 rounded-full border-2 border-red-500/10 animate-spin-slow hidden lg:block"></div>

      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-36 text-center">
        <!-- Team Shield/Badge -->
        <div class="flex justify-center mb-8">
          <div class="w-36 h-36 md:w-44 md:h-44 rounded-full bg-gradient-to-br from-blue-700 to-blue-900 border-4 border-orange-400 shadow-2xl flex items-center justify-center">
            <div class="text-center">
              <div class="text-4xl md:text-5xl font-black text-white leading-none">DB</div>
              <div class="text-[10px] md:text-xs font-bold text-orange-400 tracking-widest uppercase mt-1">Little League</div>
            </div>
          </div>
        </div>

        <h1 class="text-5xl md:text-7xl font-black text-white mb-4 tracking-tight animate-fade-in">
          Durham Bulls
        </h1>
        <h2 class="text-2xl md:text-3xl font-bold text-orange-400 mb-6 animate-fade-in">
          Little League Baseball
        </h2>
        <p class="text-xl md:text-2xl text-blue-200 mb-2 animate-fade-in">
          Virginia Beach, Virginia
        </p>
        <p class="text-lg text-gray-400 max-w-2xl mx-auto mb-10 animate-fade-in">
          Building character, teamwork, and a love for the game since day one.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-in">
          <a
            href="#registration"
            class="bg-orange-500 hover:bg-orange-600 text-white font-bold py-4 px-8 rounded-lg shadow-demo hover:shadow-3xl transition-all duration-300 transform hover:scale-105"
          >
            Register Your Player
          </a>
          <a
            href="#schedule"
            class="bg-transparent border-2 border-blue-400 hover:border-blue-300 text-blue-300 hover:text-white font-bold py-4 px-8 rounded-lg transition-all duration-300 transform hover:scale-105"
          >
            View Schedule
          </a>
        </div>
      </div>
    </div>

    <!-- Season Info Banner -->
    <section class="bg-gradient-to-r from-blue-900/50 via-blue-800/50 to-blue-900/50 border-y border-blue-700/30">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
          <div>
            <div class="text-3xl font-black text-orange-400">2026</div>
            <div class="text-sm text-gray-400 uppercase tracking-wide">Spring Season</div>
          </div>
          <div>
            <div class="text-3xl font-black text-orange-400">5-14</div>
            <div class="text-sm text-gray-400 uppercase tracking-wide">Ages</div>
          </div>
          <div>
            <div class="text-3xl font-black text-orange-400">8</div>
            <div class="text-sm text-gray-400 uppercase tracking-wide">Teams</div>
          </div>
          <div>
            <div class="text-3xl font-black text-orange-400">120+</div>
            <div class="text-sm text-gray-400 uppercase tracking-wide">Players</div>
          </div>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section class="py-20 bg-black">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-white mb-4">About Our League</h2>
          <div class="w-20 h-1 bg-orange-500 mx-auto mb-6"></div>
          <p class="text-xl text-gray-400 max-w-3xl mx-auto">
            The Durham Bulls Little League is a community-driven youth baseball organization
            proudly serving families across Virginia Beach. We believe every child deserves the
            chance to step up to the plate.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Card 1 -->
          <div class="bg-gradient-to-br from-gray-800/80 to-gray-900/80 backdrop-blur-sm rounded-2xl border border-gray-700/50 p-8 shadow-2xl">
            <div class="w-14 h-14 bg-blue-700 rounded-xl mb-6 flex items-center justify-center">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-white mb-3">All Skill Levels</h3>
            <p class="text-gray-400">
              From T-Ball beginners to competitive Majors, we have a division for every young
              player ready to learn and grow on the diamond.
            </p>
          </div>

          <!-- Card 2 -->
          <div class="bg-gradient-to-br from-gray-800/80 to-gray-900/80 backdrop-blur-sm rounded-2xl border border-gray-700/50 p-8 shadow-2xl">
            <div class="w-14 h-14 bg-blue-700 rounded-xl mb-6 flex items-center justify-center">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-white mb-3">Safety First</h3>
            <p class="text-gray-400">
              All coaches are background-checked and trained in first aid. We follow Little League
              International safety standards and pitch count guidelines.
            </p>
          </div>

          <!-- Card 3 -->
          <div class="bg-gradient-to-br from-gray-800/80 to-gray-900/80 backdrop-blur-sm rounded-2xl border border-gray-700/50 p-8 shadow-2xl">
            <div class="w-14 h-14 bg-blue-700 rounded-xl mb-6 flex items-center justify-center">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-white mb-3">Community Spirit</h3>
            <p class="text-gray-400">
              More than a league — we're a family. Team cookouts, end-of-season celebrations,
              and volunteer opportunities bring our community together.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Divisions Section -->
    <section class="py-20 bg-gradient-card">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-white mb-4">Age Divisions</h2>
          <div class="w-20 h-1 bg-orange-500 mx-auto mb-6"></div>
          <p class="text-xl text-gray-400 max-w-2xl mx-auto">
            Every player finds the right level of challenge and fun.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- T-Ball -->
          <div class="bg-black/60 border border-gray-700/50 rounded-xl p-6 text-center hover:border-orange-500/50 transition-all duration-300 hover:-translate-y-1">
            <div class="text-5xl mb-4">&#9918;</div>
            <h3 class="text-xl font-bold text-white mb-2">T-Ball</h3>
            <p class="text-orange-400 font-semibold mb-3">Ages 5-6</p>
            <p class="text-gray-400 text-sm">
              Introduction to baseball fundamentals. Focus on fun, coordination, and learning the basics.
            </p>
          </div>

          <!-- Coach Pitch -->
          <div class="bg-black/60 border border-gray-700/50 rounded-xl p-6 text-center hover:border-orange-500/50 transition-all duration-300 hover:-translate-y-1">
            <div class="text-5xl mb-4">&#9917;</div>
            <h3 class="text-xl font-bold text-white mb-2">Coach Pitch</h3>
            <p class="text-orange-400 font-semibold mb-3">Ages 7-8</p>
            <p class="text-gray-400 text-sm">
              Coaches pitch to develop hitting skills. Players learn base running and field positions.
            </p>
          </div>

          <!-- Minors -->
          <div class="bg-black/60 border border-gray-700/50 rounded-xl p-6 text-center hover:border-orange-500/50 transition-all duration-300 hover:-translate-y-1">
            <div class="text-5xl mb-4">&#9776;</div>
            <h3 class="text-xl font-bold text-white mb-2">Minors</h3>
            <p class="text-orange-400 font-semibold mb-3">Ages 9-10</p>
            <p class="text-gray-400 text-sm">
              Player pitch begins. Competitive play with a focus on skill development and sportsmanship.
            </p>
          </div>

          <!-- Majors -->
          <div class="bg-black/60 border border-gray-700/50 rounded-xl p-6 text-center hover:border-orange-500/50 transition-all duration-300 hover:-translate-y-1">
            <div class="text-5xl mb-4">&#127942;</div>
            <h3 class="text-xl font-bold text-white mb-2">Majors</h3>
            <p class="text-orange-400 font-semibold mb-3">Ages 11-14</p>
            <p class="text-gray-400 text-sm">
              Full competitive play. Advanced strategy, tournament eligibility, and All-Star selections.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Schedule Section -->
    <section id="schedule" class="py-20 bg-black">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-white mb-4">2026 Spring Schedule</h2>
          <div class="w-20 h-1 bg-orange-500 mx-auto mb-6"></div>
        </div>

        <div class="max-w-3xl mx-auto space-y-4">
          <!-- Timeline Items -->
          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-28 text-right">
              <span class="text-orange-400 font-bold">Feb 15</span>
            </div>
            <div class="flex-shrink-0 w-4 h-4 mt-1 rounded-full bg-blue-600 border-2 border-blue-400"></div>
            <div>
              <h4 class="text-white font-semibold">Registration Opens</h4>
              <p class="text-gray-400 text-sm">Online registration begins for the Spring 2026 season</p>
            </div>
          </div>

          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-28 text-right">
              <span class="text-orange-400 font-bold">Mar 8</span>
            </div>
            <div class="flex-shrink-0 w-4 h-4 mt-1 rounded-full bg-blue-600 border-2 border-blue-400"></div>
            <div>
              <h4 class="text-white font-semibold">Player Evaluations</h4>
              <p class="text-gray-400 text-sm">Skills assessments for team placement at Veterans United Park</p>
            </div>
          </div>

          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-28 text-right">
              <span class="text-orange-400 font-bold">Mar 15</span>
            </div>
            <div class="flex-shrink-0 w-4 h-4 mt-1 rounded-full bg-blue-600 border-2 border-blue-400"></div>
            <div>
              <h4 class="text-white font-semibold">Team Draft</h4>
              <p class="text-gray-400 text-sm">Coaches select players and rosters are finalized</p>
            </div>
          </div>

          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-28 text-right">
              <span class="text-orange-400 font-bold">Mar 22</span>
            </div>
            <div class="flex-shrink-0 w-4 h-4 mt-1 rounded-full bg-blue-600 border-2 border-blue-400"></div>
            <div>
              <h4 class="text-white font-semibold">Practices Begin</h4>
              <p class="text-gray-400 text-sm">Team practices start — 2 sessions per week</p>
            </div>
          </div>

          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-28 text-right">
              <span class="text-orange-400 font-bold">Apr 5</span>
            </div>
            <div class="flex-shrink-0 w-4 h-4 mt-1 rounded-full bg-orange-500 border-2 border-orange-400"></div>
            <div>
              <h4 class="text-white font-semibold">Opening Day!</h4>
              <p class="text-gray-400 text-sm">Opening ceremonies, first pitch, and games kick off the season</p>
            </div>
          </div>

          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-28 text-right">
              <span class="text-orange-400 font-bold">Jun 6</span>
            </div>
            <div class="flex-shrink-0 w-4 h-4 mt-1 rounded-full bg-blue-600 border-2 border-blue-400"></div>
            <div>
              <h4 class="text-white font-semibold">Regular Season Ends</h4>
              <p class="text-gray-400 text-sm">Final regular season games</p>
            </div>
          </div>

          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-28 text-right">
              <span class="text-orange-400 font-bold">Jun 13</span>
            </div>
            <div class="flex-shrink-0 w-4 h-4 mt-1 rounded-full bg-orange-500 border-2 border-orange-400"></div>
            <div>
              <h4 class="text-white font-semibold">Playoffs & Championship</h4>
              <p class="text-gray-400 text-sm">End-of-season tournament and awards ceremony</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Location & Field Info -->
    <section class="py-20 bg-gradient-card">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-white mb-4">Our Fields</h2>
          <div class="w-20 h-1 bg-orange-500 mx-auto mb-6"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-gradient-to-br from-gray-800/80 to-gray-900/80 backdrop-blur-sm rounded-2xl border border-gray-700/50 p-8 shadow-2xl">
            <h3 class="text-2xl font-bold text-orange-400 mb-4">Veterans United Park</h3>
            <ul class="space-y-3">
              <li class="flex items-start text-gray-300">
                <svg class="w-5 h-5 text-blue-400 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                Virginia Beach, VA
              </li>
              <li class="flex items-start text-gray-300">
                <svg class="w-5 h-5 text-blue-400 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
                4 regulation Little League diamonds
              </li>
              <li class="flex items-start text-gray-300">
                <svg class="w-5 h-5 text-blue-400 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                </svg>
                Lighted fields for evening games
              </li>
              <li class="flex items-start text-gray-300">
                <svg class="w-5 h-5 text-blue-400 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                </svg>
                Concession stand and covered bleachers
              </li>
            </ul>
          </div>

          <div class="bg-gradient-to-br from-gray-800/80 to-gray-900/80 backdrop-blur-sm rounded-2xl border border-gray-700/50 p-8 shadow-2xl">
            <h3 class="text-2xl font-bold text-orange-400 mb-4">Practice Facilities</h3>
            <ul class="space-y-3">
              <li class="flex items-start text-gray-300">
                <svg class="w-5 h-5 text-blue-400 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                2 batting cages (adjustable speed)
              </li>
              <li class="flex items-start text-gray-300">
                <svg class="w-5 h-5 text-blue-400 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Bullpen mound for pitcher warm-ups
              </li>
              <li class="flex items-start text-gray-300">
                <svg class="w-5 h-5 text-blue-400 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Infield practice area
              </li>
              <li class="flex items-start text-gray-300">
                <svg class="w-5 h-5 text-blue-400 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Equipment storage and team rooms
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Registration Section -->
    <section id="registration" class="py-20 bg-black">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-white mb-4">Player Registration</h2>
          <div class="w-20 h-1 bg-orange-500 mx-auto mb-6"></div>
          <p class="text-xl text-gray-400 max-w-2xl mx-auto">
            Sign up your player for the 2026 Spring Season. Registration fee includes uniform, hat, and end-of-season trophy.
          </p>
        </div>

        <!-- Registration Form -->
        <div class="bg-gradient-to-br from-gray-800/80 to-gray-900/80 backdrop-blur-sm rounded-2xl border border-gray-700/50 p-8 md:p-10 shadow-2xl">
          <form id="registration-form" class="space-y-6">
            <!-- Parent/Guardian Info -->
            <h3 class="text-xl font-bold text-orange-400 mb-4">Parent / Guardian Information</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="parent-first" class="block text-sm font-medium text-gray-300 mb-2">First Name *</label>
                <input type="text" id="parent-first" required
                  class="w-full bg-black/50 border border-gray-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all"
                  placeholder="First name"
                />
              </div>
              <div>
                <label for="parent-last" class="block text-sm font-medium text-gray-300 mb-2">Last Name *</label>
                <input type="text" id="parent-last" required
                  class="w-full bg-black/50 border border-gray-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all"
                  placeholder="Last name"
                />
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="parent-email" class="block text-sm font-medium text-gray-300 mb-2">Email *</label>
                <input type="email" id="parent-email" required
                  class="w-full bg-black/50 border border-gray-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all"
                  placeholder="email@example.com"
                />
              </div>
              <div>
                <label for="parent-phone" class="block text-sm font-medium text-gray-300 mb-2">Phone *</label>
                <input type="tel" id="parent-phone" required
                  class="w-full bg-black/50 border border-gray-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all"
                  placeholder="(757) 555-0123"
                />
              </div>
            </div>

            <!-- Divider -->
            <div class="border-t border-gray-700 my-8"></div>

            <!-- Player Info -->
            <h3 class="text-xl font-bold text-orange-400 mb-4">Player Information</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label for="player-first" class="block text-sm font-medium text-gray-300 mb-2">Player First Name *</label>
                <input type="text" id="player-first" required
                  class="w-full bg-black/50 border border-gray-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all"
                  placeholder="Player's first name"
                />
              </div>
              <div>
                <label for="player-last" class="block text-sm font-medium text-gray-300 mb-2">Player Last Name *</label>
                <input type="text" id="player-last" required
