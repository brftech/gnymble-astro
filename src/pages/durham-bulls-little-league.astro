---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

// Team data — in production this would come from Supabase
const team = {
  name: "Durham Bulls",
  league: "Great Neck Baseball League",
  location: "Virginia Beach, VA",
  division: "Minors (Ages 9-10)",
  season: "Spring 2026",
  record: { wins: 6, losses: 2, ties: 0 },
  coaches: [
    { name: "Coach Mike Patterson", role: "Head Coach", phone: "(757) 555-0147", email: "coach.mike@gnbl.org" },
    { name: "Coach Dave Rivera", role: "Assistant Coach", phone: "(757) 555-0234", email: "coach.dave@gnbl.org" },
  ],
  nextGame: {
    opponent: "Great Neck Sharks",
    date: "Saturday, Mar 15",
    time: "10:00 AM",
    field: "Great Neck Park — Field 2",
    isHome: true,
  },
};

const roster = [
  { number: 1, name: "Ethan Carter", position: "P / SS", bats: "R", throws: "R" },
  { number: 3, name: "Marcus Johnson", position: "C", bats: "R", throws: "R" },
  { number: 5, name: "Tyler Brooks", position: "1B", bats: "L", throws: "L" },
  { number: 7, name: "Noah Williams", position: "2B", bats: "R", throws: "R" },
  { number: 8, name: "Jayden Thomas", position: "SS / P", bats: "S", throws: "R" },
  { number: 10, name: "Aiden Patel", position: "3B", bats: "R", throws: "R" },
  { number: 12, name: "Caleb Martinez", position: "LF", bats: "L", throws: "R" },
  { number: 14, name: "Owen Scott", position: "CF", bats: "R", throws: "R" },
  { number: 15, name: "Liam Chen", position: "RF", bats: "L", throws: "L" },
  { number: 18, name: "Dylan Foster", position: "P / 1B", bats: "R", throws: "R" },
  { number: 21, name: "Brandon Murphy", position: "OF / 2B", bats: "R", throws: "R" },
  { number: 23, name: "Jackson Reid", position: "OF / 3B", bats: "L", throws: "R" },
];

const schedule = [
  { date: "Mar 1", opponent: "Great Neck Eagles", home: true, result: "W 7-3", lineup: true },
  { date: "Mar 4", opponent: "Bayville Wildcats", home: false, result: "W 5-2", lineup: true },
  { date: "Mar 8", opponent: "Oceanfront Rays", home: true, result: "L 3-6", lineup: true },
  { date: "Mar 11", opponent: "Lynnhaven Tigers", home: false, result: "W 8-1", lineup: true },
  { date: "Mar 15", opponent: "Great Neck Sharks", home: true, result: null, lineup: true },
  { date: "Mar 18", opponent: "Kempsville Braves", home: false, result: null, lineup: false },
  { date: "Mar 22", opponent: "Bayville Wildcats", home: true, result: null, lineup: false },
  { date: "Mar 25", opponent: "Oceanfront Rays", home: false, result: null, lineup: false },
  { date: "Mar 29", opponent: "Great Neck Eagles", home: false, result: null, lineup: false },
  { date: "Apr 1", opponent: "Lynnhaven Tigers", home: true, result: null, lineup: false },
];

const announcements = [
  {
    date: "Mar 13, 2026",
    title: "Saturday's Game — Lineup Posted",
    message: "Lineup for the Sharks game this Saturday is posted below. Please arrive by 9:15 AM for warm-ups. Don't forget water bottles and sunscreen!",
    pinned: true,
  },
  {
    date: "Mar 11, 2026",
    title: "Great Win Tonight!",
    message: "What a game! 8-1 over the Tigers. Jayden pitched 4 strong innings and Ethan had 3 hits. Team pizza at Sal's after — thanks to the Murphy family for treating!",
    pinned: false,
  },
  {
    date: "Mar 9, 2026",
    title: "Practice Schedule Change",
    message: "Wednesday practice this week is moved from 5:30 PM to 6:00 PM due to field maintenance. Same location — Great Neck Park, Field 3.",
    pinned: false,
  },
  {
    date: "Mar 5, 2026",
    title: "Snack Sign-Up Reminder",
    message: "We still need snack volunteers for the Mar 15 and Mar 22 games. Please reply to Coach Mike's text or sign up on the sheet at the next practice.",
    pinned: false,
  },
];

const nextLineup = {
  game: "vs. Great Neck Sharks — Sat, Mar 15 @ 10:00 AM",
  battingOrder: [
    { order: 1, name: "Owen Scott", position: "CF" },
    { order: 2, name: "Jayden Thomas", position: "SS" },
    { order: 3, name: "Ethan Carter", position: "P" },
    { order: 4, name: "Tyler Brooks", position: "1B" },
    { order: 5, name: "Aiden Patel", position: "3B" },
    { order: 6, name: "Marcus Johnson", position: "C" },
    { order: 7, name: "Caleb Martinez", position: "LF" },
    { order: 8, name: "Noah Williams", position: "2B" },
    { order: 9, name: "Liam Chen", position: "RF" },
  ],
  bench: [
    { name: "Dylan Foster", note: "Relief pitcher — innings 3-4" },
    { name: "Brandon Murphy", note: "Sub OF — entering inning 4" },
    { name: "Jackson Reid", note: "Sub IF — entering inning 4" },
  ],
};
---

<Layout title="Durham Bulls — Great Neck Baseball League | Virginia Beach, VA">
  <Navigation />

  <main class="min-h-screen bg-black">
    <!-- Team Header -->
    <div class="relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-blue-950 via-black to-blue-950"></div>
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 50% 130%, rgba(34, 197, 94, 0.12) 0%, transparent 55%);"></div>

      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
        <div class="flex flex-col md:flex-row items-center gap-8">
          <!-- Badge -->
          <div class="flex-shrink-0 w-32 h-32 md:w-40 md:h-40 rounded-full bg-gradient-to-br from-blue-700 to-blue-900 border-4 border-orange-400 shadow-2xl flex items-center justify-center">
            <div class="text-center">
              <div class="text-4xl md:text-5xl font-black text-white leading-none">DB</div>
              <div class="text-[9px] md:text-[10px] font-bold text-orange-400 tracking-widest uppercase mt-1">Est. 2026</div>
            </div>
          </div>

          <!-- Team Info -->
          <div class="text-center md:text-left">
            <p class="text-sm text-blue-300 uppercase tracking-widest font-semibold mb-1">{team.league}</p>
            <h1 class="text-5xl md:text-6xl font-black text-white tracking-tight mb-2">{team.name}</h1>
            <p class="text-xl text-gray-400 mb-4">{team.division} &middot; {team.location}</p>
            <div class="flex flex-wrap items-center gap-4 justify-center md:justify-start">
              <span class="bg-blue-900/60 border border-blue-700/50 text-blue-200 text-sm font-semibold px-4 py-1.5 rounded-full">
                {team.season}
              </span>
              <span class="bg-green-900/40 border border-green-700/50 text-green-300 text-sm font-semibold px-4 py-1.5 rounded-full">
                Record: {team.record.wins}-{team.record.losses}
              </span>
            </div>
          </div>
        </div>

        <!-- Quick Nav -->
        <div class="flex flex-wrap gap-3 mt-10 justify-center md:justify-start">
          <a href="#announcements" class="bg-orange-500 hover:bg-orange-600 text-white font-bold py-2.5 px-6 rounded-lg transition-all duration-300 text-sm">Announcements</a>
          <a href="#roster" class="bg-white/10 hover:bg-white/20 text-white font-semibold py-2.5 px-6 rounded-lg transition-all duration-300 text-sm border border-white/10">Roster</a>
          <a href="#lineup" class="bg-white/10 hover:bg-white/20 text-white font-semibold py-2.5 px-6 rounded-lg transition-all duration-300 text-sm border border-white/10">Next Lineup</a>
          <a href="#schedule" class="bg-white/10 hover:bg-white/20 text-white font-semibold py-2.5 px-6 rounded-lg transition-all duration-300 text-sm border border-white/10">Schedule</a>
          <a href="#message" class="bg-white/10 hover:bg-white/20 text-white font-semibold py-2.5 px-6 rounded-lg transition-all duration-300 text-sm border border-white/10">Message Coach</a>
        </div>
      </div>
    </div>

    <!-- Next Game Banner -->
    <section class="bg-gradient-to-r from-orange-600/20 via-orange-500/10 to-orange-600/20 border-y border-orange-500/30">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <span class="bg-orange-500 text-white text-xs font-black uppercase px-3 py-1 rounded-full animate-pulse">Next Game</span>
            <span class="text-white font-bold text-lg">
              {team.nextGame.isHome ? "vs." : "@"} {team.nextGame.opponent}
            </span>
          </div>
          <div class="flex items-center gap-6 text-sm text-gray-300">
            <span>{team.nextGame.date}</span>
            <span class="text-orange-400 font-semibold">{team.nextGame.time}</span>
            <span>{team.nextGame.field}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Announcements -->
    <section id="announcements" class="py-16 bg-black">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-white mb-2">Team Updates</h2>
        <p class="text-gray-500 mb-8">News and messages from the coaching staff</p>

        <div class="space-y-4">
          {announcements.map((post) => (
            <div class={`rounded-xl border p-6 ${post.pinned ? 'bg-orange-500/5 border-orange-500/30' : 'bg-gray-900/50 border-gray-700/50'}`}>
              <div class="flex items-start justify-between gap-4 mb-2">
                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                  {post.pinned && <span class="text-orange-400 text-sm">&#128204;</span>}
                  {post.title}
                </h3>
                <span class="text-xs text-gray-500 flex-shrink-0 mt-1">{post.date}</span>
              </div>
              <p class="text-gray-400 leading-relaxed">{post.message}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Roster -->
    <section id="roster" class="py-16 bg-gradient-card">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-white mb-2">Team Roster</h2>
        <p class="text-gray-500 mb-8">{team.season} &middot; {roster.length} players</p>

        <!-- Roster Table -->
        <div class="bg-gray-900/60 rounded-2xl border border-gray-700/50 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b border-gray-700/50">
                  <th class="text-left text-xs font-bold text-gray-400 uppercase tracking-wider px-6 py-4 w-16">#</th>
                  <th class="text-left text-xs font-bold text-gray-400 uppercase tracking-wider px-6 py-4">Player</th>
                  <th class="text-left text-xs font-bold text-gray-400 uppercase tracking-wider px-6 py-4">Position</th>
                  <th class="text-center text-xs font-bold text-gray-400 uppercase tracking-wider px-6 py-4">Bats</th>
                  <th class="text-center text-xs font-bold text-gray-400 uppercase tracking-wider px-6 py-4">Throws</th>
                </tr>
              </thead>
              <tbody>
                {roster.map((player, i) => (
                  <tr class={`border-b border-gray-800/50 ${i % 2 === 0 ? '' : 'bg-gray-800/20'} hover:bg-blue-900/20 transition-colors`}>
                    <td class="px-6 py-3.5">
                      <span class="bg-blue-800/60 text-blue-200 text-sm font-bold w-8 h-8 rounded-full flex items-center justify-center">{player.number}</span>
                    </td>
                    <td class="px-6 py-3.5 text-white font-semibold">{player.name}</td>
                    <td class="px-6 py-3.5 text-gray-400">{player.position}</td>
                    <td class="px-6 py-3.5 text-center text-gray-400">{player.bats}</td>
                    <td class="px-6 py-3.5 text-center text-gray-400">{player.throws}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Coaching Staff -->
        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {team.coaches.map((coach) => (
            <div class="bg-gray-900/60 rounded-xl border border-gray-700/50 p-5 flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-orange-500/20 border border-orange-500/40 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
              </div>
              <div>
                <p class="text-white font-semibold">{coach.name}</p>
                <p class="text-orange-400 text-sm">{coach.role}</p>
                <p class="text-gray-500 text-sm">{coach.phone}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Next Game Lineup -->
    <section id="lineup" class="py-16 bg-black">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-white mb-2">Game Day Lineup</h2>
        <p class="text-gray-500 mb-8">{nextLineup.game}</p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Batting Order -->
          <div class="md:col-span-2 bg-gray-900/60 rounded-2xl border border-gray-700/50 overflow-hidden">
            <div class="bg-blue-900/30 border-b border-blue-700/30 px-6 py-3">
              <h3 class="text-sm font-bold text-blue-200 uppercase tracking-wider">Batting Order</h3>
            </div>
            <div class="divide-y divide-gray-800/50">
              {nextLineup.battingOrder.map((slot) => (
                <div class="flex items-center px-6 py-3 hover:bg-blue-900/10 transition-colors">
                  <span class="w-8 h-8 rounded-full bg-orange-500/20 text-orange-400 font-bold text-sm flex items-center justify-center mr-4">{slot.order}</span>
                  <span class="text-white font-semibold flex-1">{slot.name}</span>
                  <span class="text-gray-400 text-sm bg-gray-800/60 px-3 py-1 rounded-full">{slot.position}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Bench / Subs -->
          <div class="bg-gray-900/60 rounded-2xl border border-gray-700/50 overflow-hidden">
            <div class="bg-gray-800/50 border-b border-gray-700/30 px-6 py-3">
              <h3 class="text-sm font-bold text-gray-300 uppercase tracking-wider">Bench / Subs</h3>
            </div>
            <div class="divide-y divide-gray-800/50">
              {nextLineup.bench.map((sub) => (
                <div class="px-6 py-4">
                  <p class="text-white font-semibold text-sm">{sub.name}</p>
                  <p class="text-gray-500 text-xs mt-1">{sub.note}</p>
                </div>
              ))}
            </div>
            <div class="px-6 py-4 bg-green-900/10 border-t border-green-800/20">
              <p class="text-green-300 text-xs">
                All players will see at least 2 innings of play per league rules.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Season Schedule -->
    <section id="schedule" class="py-16 bg-gradient-card">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-white mb-2">Season Schedule</h2>
        <p class="text-gray-500 mb-8">{team.season} &middot; {team.league}</p>

        <div class="bg-gray-900/60 rounded-2xl border border-gray-700/50 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="border-b border-gray-700/50">
                  <th class="text-left text-xs font-bold text-gray-400 uppercase tracking-wider px-6 py-4">Date</th>
                  <th class="text-left text-xs font-bold text-gray-400 uppercase tracking-wider px-6 py-4">Opponent</th>
                  <th class="text-center text-xs font-bold text-gray-400 uppercase tracking-wider px-6 py-4">H/A</th>
                  <th class="text-center text-xs font-bold text-gray-400 uppercase tracking-wider px-6 py-4">Result</th>
                </tr>
              </thead>
              <tbody>
                {schedule.map((game, i) => {
                  const isNext = game.result === null && (i === 0 || schedule[i-1].result !== null);
                  const isWin = game.result?.startsWith("W");
                  const isLoss = game.result?.startsWith("L");
                  return (
                    <tr class={`border-b border-gray-800/50 transition-colors ${isNext ? 'bg-orange-500/5 border-l-2 border-l-orange-500' : ''} hover:bg-blue-900/10`}>
                      <td class="px-6 py-3.5 text-gray-300 font-medium">{game.date}</td>
                      <td class="px-6 py-3.5 text-white font-semibold">
                        {game.opponent}
                        {isNext && <span class="ml-2 text-xs bg-orange-500 text-white px-2 py-0.5 rounded-full font-bold">NEXT</span>}
                      </td>
                      <td class="px-6 py-3.5 text-center text-gray-400">{game.home ? "Home" : "Away"}</td>
                      <td class="px-6 py-3.5 text-center">
                        {game.result ? (
                          <span class={`font-bold text-sm ${isWin ? 'text-green-400' : 'text-red-400'}`}>{game.result}</span>
                        ) : (
                          <span class="text-gray-600 text-sm">—</span>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Message Coach / Parent Board -->
    <section id="message" class="py-16 bg-black">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Message Coach -->
          <div>
            <h2 class="text-3xl font-bold text-white mb-2">Message the Coach</h2>
            <p class="text-gray-500 mb-6">Questions about schedules, playing time, carpools, or anything else</p>

            <div class="bg-gray-900/60 rounded-2xl border border-gray-700/50 p-6">
              <form id="parent-message-form" class="space-y-4">
                <div>
                  <label for="msg-parent-name" class="block text-sm font-medium text-gray-300 mb-1.5">Your Name *</label>
                  <input type="text" id="msg-parent-name" required
                    class="w-full bg-black/50 border border-gray-600 rounded-lg px-4 py-2.5 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all text-sm"
                    placeholder="Parent / guardian name"
                  />
                </div>
                <div>
                  <label for="msg-player-name" class="block text-sm font-medium text-gray-300 mb-1.5">Player Name *</label>
                  <input type="text" id="msg-player-name" required
                    class="w-full bg-black/50 border border-gray-600 rounded-lg px-4 py-2.5 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all text-sm"
                    placeholder="Your child's name"
                  />
                </div>
                <div>
                  <label for="msg-type" class="block text-sm font-medium text-gray-300 mb-1.5">Topic</label>
                  <select id="msg-type"
                    class="w-full bg-black/50 border border-gray-600 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all text-sm"
                  >
                    <option value="general" class="bg-gray-900">General Question</option>
                    <option value="absence" class="bg-gray-900">Absence / Late Arrival</option>
                    <option value="carpool" class="bg-gray-900">Carpool Coordination</option>
                    <option value="schedule" class="bg-gray-900">Schedule Question</option>
                    <option value="equipment" class="bg-gray-900">Equipment / Uniform</option>
                    <option value="other" class="bg-gray-900">Other</option>
                  </select>
                </div>
                <div>
                  <label for="msg-body" class="block text-sm font-medium text-gray-300 mb-1.5">Message *</label>
                  <textarea id="msg-body" rows="4" required
                    class="w-full bg-black/50 border border-gray-600 rounded-lg px-4 py-2.5 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent transition-all text-sm"
                    placeholder="Type your message..."
                  ></textarea>
                </div>
                <button type="submit"
                  class="w-full bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 px-6 rounded-lg shadow-demo hover:shadow-3xl transition-all duration-300 text-sm"
                >
                  Send Message
                </button>
              </form>
            </div>
          </div>

          <!-- Quick Info & Team Reminders -->
          <div>
            <h2 class="text-3xl font-bold text-white mb-2">Team Info</h2>
            <p class="text-gray-500 mb-6">Key details and reminders for parents</p>

            <div class="space-y-4">
              <!-- Practice Schedule -->
              <div class="bg-gray-900/60 rounded-xl border border-gray-700/50 p-5">
                <h3 class="text-sm font-bold text-orange-400 uppercase tracking-wider mb-3">Practice Schedule</h3>
                <div class="space-y-2 text-sm">
                  <div class="flex justify-between text-gray-300">
                    <span>Tuesday</span>
                    <span class="text-white font-medium">5:30 – 7:00 PM</span>
                  </div>
                  <div class="flex justify-between text-gray-300">
                    <span>Thursday</span>
                    <span class="text-white font-medium">5:30 – 7:00 PM</span>
                  </div>
                  <p class="text-gray-500 text-xs mt-2">Great Neck Park — Field 3</p>
                </div>
              </div>

              <!-- What to Bring -->
              <div class="bg-gray-900/60 rounded-xl border border-gray-700/50 p-5">
                <h3 class="text-sm font-bold text-orange-400 uppercase tracking-wider mb-3">Game Day Checklist</h3>
                <ul class="space-y-1.5 text-sm text-gray-300">
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 bg-blue-400 rounded-full"></span>
                    Full uniform (jersey, pants, belt, socks)
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 bg-blue-400 rounded-full"></span>
                    Cleats and team hat
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 bg-blue-400 rounded-full"></span>
                    Glove and bat (if you have one)
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 bg-blue-400 rounded-full"></span>
                    Water bottle and snack
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 bg-blue-400 rounded-full"></span>
                    Sunscreen and cap
                  </li>
                </ul>
              </div>

              <!-- Snack Schedule -->
              <div class="bg-gray-900/60 rounded-xl border border-gray-700/50 p-5">
                <h3 class="text-sm font-bold text-orange-400 uppercase tracking-wider mb-3">Snack Duty</h3>
                <div class="space-y-2 text-sm">
                  <div class="flex justify-between text-gray-300">
                    <span>Mar 15 — Sharks</span>
                    <span class="text-yellow-400 italic">Volunteer needed</span>
                  </div>
                  <div class="flex justify-between text-gray-300">
                    <span>Mar 22 — Wildcats</span>
                    <span class="text-yellow-400 italic">Volunteer needed</span>
                  </div>
                  <div class="flex justify-between text-gray-300">
