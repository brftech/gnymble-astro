<script>
  // Message form
  const msgForm = document.getElementById('parent-message-form') as HTMLFormElement;
  if (msgForm) {
    msgForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(msgForm);
      const data: Record<string, string> = {};
      formData.forEach((value, key) => { data[key] = value.toString(); });
      console.log('Parent message submitted:', data);

      msgForm.innerHTML = `
        <div class="text-center py-8">
          <div class="text-4xl mb-4">&#9989;</div>
          <h3 class="text-lg font-bold text-white mb-2">Message Sent!</h3>
          <p class="text-gray-400 text-sm">Coach Mike will get back to you soon.</p>
        </div>
      `;
    });
  }

  // RSVP buttons
  const rsvpYes = document.getElementById('rsvp-yes');
  const rsvpNo = document.getElementById('rsvp-no');
  const rsvpConfirm = document.getElementById('rsvp-confirmation');

  function handleRsvp(response: string) {
    if (rsvpConfirm) {
      rsvpConfirm.classList.remove('hidden');
      if (response === 'yes') {
        rsvpConfirm.innerHTML = '<span class="text-green-400">Confirmed — see you Saturday!</span>';
      } else {
        rsvpConfirm.innerHTML = '<span class="text-red-400">Got it — we\'ll miss you. Let us know if plans change!</span>';
      }
    }
    if (rsvpYes) rsvpYes.setAttribute('disabled', 'true');
    if (rsvpNo) rsvpNo.setAttribute('disabled', 'true');
    console.log('RSVP:', response);
  }

  rsvpYes?.addEventListener('click', () => handleRsvp('yes'));
  rsvpNo?.addEventListener('click', () => handleRsvp('no'));
</script>

