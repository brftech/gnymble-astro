<script>
  const form = document.getElementById('registration-form') as HTMLFormElement;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data: Record<string, string> = {};
      formData.forEach((value, key) => {
        data[key] = value.toString();
      });
      console.log('Registration submitted:', data);

      // Show success message
      form.innerHTML = `
        <div class="text-center py-12">
          <div class="text-6xl mb-6">&#9918;</div>
          <h3 class="text-2xl font-bold text-white mb-4">Registration Received!</h3>
          <p class="text-gray-400 text-lg mb-2">
            Thank you for registering your player with the Durham Bulls Little League.
          </p>
          <p class="text-gray-400">
            We'll send a confirmation email with next steps, including evaluation dates and what to bring.
          </p>
          <a href="/durham-bulls-little-league" class="inline-block mt-8 text-orange-400 hover:text-orange-300 font-semibold underline">
            Back to top
          </a>
        </div>
      `;
    });
  }
</script>

